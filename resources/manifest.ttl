PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX mrr: <https://prez.dev/ManifestResourceRoles/>
PREFIX prez: <https://prez.dev/>
PREFIX schema: <https://schema.org/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>

[]    a prez:Manifest ;
    prof:hasResource 
        [
            prof:hasArtifact "_background/*.ttl" ;
            prof:hasRole mrr:CompleteCatalogueAndResourceLabels ;
        ] ,
        [
            prof:hasArtifact "vocabs/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            dcterms:conformsTo <https://linked.data.gov.au/def/vocpub/validator> ;
            prof:hasArtifact
                "vocabs/items/abis-mapping/*.ttl" ,
                "vocabs/items/asls/*.ttl" ,
                "vocabs/items/RoleCode.ttl" ,
                "vocabs/items/abis-themes.ttl" ,
                "vocabs/items/datatypes.ttl" ,
                "vocabs/items/epbc-ts-cats.ttl" ,
                "vocabs/items/mesh-block-categories.ttl" ,
                "vocabs/items/nsl-tn-types.ttl" ,
                "vocabs/items/nsl-tnu-types.ttl" ,
                "vocabs/items/obsprops.ttl" ,
                "vocabs/items/rescope.ttl" ,
                "vocabs/items/sma.ttl" ,
                "vocabs/items/smrr.ttl" ,
                "vocabs/items/statsprops.ttl" ,
                "vocabs/items/tern-cv-categorical_concepts.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            # TERN defines Taxon ranks as a Collection, not a ConceptScheme.
            # Identify it explicitly; the VocPub scheme profile does not apply.
            prof:hasArtifact [
                schema:mainEntity <http://linked.data.gov.au/def/tern-cv/c14559b5-6a80-4045-ab48-a70d1612a685> ;
                schema:contentLocation "vocabs/items/tern-cv-taxon-ranks.ttl" ;
            ] ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            # Temporary: orgs.ttl currently fails VocPub validation, which needs to be fixed
            prof:hasArtifact "vocabs/items/orgs.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            prof:hasArtifact "models/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            dcterms:conformsTo <https://linked.data.gov.au/def/ontpub/validator> ;
            prof:hasArtifact "models/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            prof:hasArtifact "models/non-ontpub/tern.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            #dcterms:conformsTo <https://linked.data.gov.au/def/valpub/validator> ;
            prof:hasArtifact "validators/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            #dcterms:conformsTo <https://linked.data.gov.au/def/valpub/validator> ;
            prof:hasArtifact "validators/valpub/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            prof:hasArtifact "validators/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ,
        [
            prof:hasArtifact "datasets/items/*.ttl" ;
            prof:hasRole mrr:ResourceData ;
        ] ,
        [
            prof:hasArtifact "datasets/_cat.ttl" ;
            prof:hasRole mrr:CatalogueData ;
        ] ;
.
