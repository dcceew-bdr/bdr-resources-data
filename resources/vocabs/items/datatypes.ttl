    skos:definition "String literal type that represents the unique identifier for a Project in MERIT."@en ;
    skos:historyNote "Defined by TERN Australia for use the BDR." ;
    skos:inScheme cs: ;
    skos:prefLabel "MERITProjectID"@en ;
    skos:topConceptOf cs: ;
    dcat:contactPoint <https://linked.data.gov.au/org/tern> .

:MERITSampleID a rdfs:Datatype,
        skos:Concept ;
    dcterms:replaces :MERITSampleID ;
    rdfs:isDefinedBy cs: ;
    skos:definition "String literal type that represents the unique identifier for Sample in the of a MERIT submission to the BDR."@en ;
    skos:historyNote "Defined by TERN Australia for use the BDR." ;
    skos:inScheme cs: ;
    skos:prefLabel "MERITSampleID"@en ;
