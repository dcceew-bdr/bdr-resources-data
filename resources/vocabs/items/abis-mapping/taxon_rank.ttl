    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A group of plants selected for particular characteristics that remain distinct, uniform and stable when the plants are propagated by appropriate means."@en ;
    skos:exactMatch <http://rs.gbif.org/vocabulary/gbif/rank/cultivar> ;
    skos:example "Taxus baccata 'Variegata'."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "cultivar"@en ;
    skos:scopeNote "Used here for the cultivar category governed by the International Code of Nomenclature for Cultivated Plants (ICNCP), rather than a botanical rank under the ICN. Cultivar is not equivalent to the botanical ranks variety (varietas) or form (forma)."@en ;
    skos:topConceptOf cs: ;
.

