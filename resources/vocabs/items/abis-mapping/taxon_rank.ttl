<http://linked.data.gov.au/def/tern-cv/fdbe211f-33d6-4446-a1fb-5eb8de45dd57>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:definition "A loosely defined group of subspecies within a species."@en ;
    skos:exactMatch <http://rs.gbif.org/vocabulary/gbif/rank/subspecificAggregate> ;
    skos:inScheme cs: ;
    skos:prefLabel "subspecific aggregate"@en ;
    skos:scopeNote "Under ICZN Article 6.2, a subspecies name placed in parentheses between the species and subspecies names can denote an aggregate of subspecies. This parenthetical name is not counted as a word of the trinomen. Distinguish this grouping within one species from a species aggregate, which groups species."@en ;
    skos:topConceptOf cs: ;
.

<http://rs.gbif.org/vocabulary/gbif/rank/subkingdom>
    a skos:Concept ;
    dcterms:replaces <http://example.com/subkingdom> ;
    rdfs:isDefinedBy <http://rs.gbif.org/vocabulary/gbif/rank> ;
    skos:definition "A taxonomic rank below kingdom and above phylum (division)."@en ;
    skos:inScheme cs: ;
    skos:prefLabel "subkingdom"@en ;
    skos:topConceptOf cs: ;
.

