<http://linked.data.gov.au/def/tern-cv/bc6b552f-5ab0-4d46-a236-a99fc2005c93>
    a skos:Concept ;
    rdfs:isDefinedBy cs: ;
    skos:altLabel
        "aggregate"@en ,
        "species complex"@en ,
        "species group"@en ;
    skos:definition "A loosely defined group of species."@en ;
    skos:exactMatch <http://rs.gbif.org/vocabulary/gbif/rank/speciesAggregate> ;
    skos:inScheme cs: ;
    skos:prefLabel "species aggregate"@en ;
    skos:scopeNote "In zoological nomenclature, an aggregate groups species within a genus or subgenus; the aggregate is not itself a subgenus. Under ICZN Article 6.2, a species name in parentheses can denote the aggregate after the genus-group name. Distinguish this grouping of species from a subspecific aggregate, which groups subspecies within one species."@en ;
    skos:topConceptOf cs: ;
.

