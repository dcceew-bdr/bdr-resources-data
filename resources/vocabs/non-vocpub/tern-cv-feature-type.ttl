    skos:prefLabel "plant taxa per stratum"@en .

<http://linked.data.gov.au/def/tern-cv/9f0ed180-2b85-4efa-b09f-9e20caf1d069> a skos:Concept ;
    dcterms:created "2024-11-14T00:36:53"^^xsd:dateTime ;
    dcterms:description "Tree stump is a part of a plant and especially a tree remaining attached to the root after the trunk is cut or broken from natural disturbances. The stump may not be completely dead and can regenerate under favourable conditions, either at its apex, base, or via epicormal growth." ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "McCallum K, Potter T, Cox, B, Laws M, Bignall J, O’Neill S, Sparrow B. (2023) Condition Module. In ‘Ecological Field Monitoring Protocols Manual using the Ecological Monitoring System Australia’. (Eds S O’Neill, K Irvine, A Tokmakoff, B Sparrow). TERN, Adelaide." ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/2be2d5ce-ca9d-4dff-8e79-948983944f95> ;
    skos:definition "Standing upright portion of dead trees above ground surface <1.3 m that remains after cutting or natural processes have occurred." ;
    skos:example "A count of the total stumps, including stump height following a logging activity." ;
    skos:historyNote "Created this feature type for the EMSA Condition Module." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "tree stump"@en ;
    schema:citation "McCallum K, Potter T, Cox, B, Laws M, Bignall J, O’Neill S, Sparrow B. (2023) Condition Module. In ‘Ecological Field Monitoring Protocols Manual using the Ecological Monitoring System Australia’. (Eds S O’Neill, K Irvine, A Tokmakoff, B Sparrow). TERN, Adelaide." .

<http://linked.data.gov.au/def/tern-cv/a0bcca19-143c-4898-9f43-321bad63ebad> a skos:Concept ;
    dcterms:created "2022-09-19T05:11:30"^^xsd:dateTime ;
    dcterms:modified "2023-06-23T05:56:33"^^xsd:dateTime ;
    owl:deprecated true ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/4b36a1ab-7a77-49ca-866a-e68bce2db9e5> ;
    skos:definition "Organic material which is primarily composed of plant structures, living or dead in a specific sampled area."@en ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "stand-plant-matter" ;
    skos:prefLabel "stand plant matter"@en .

<http://linked.data.gov.au/def/tern-cv/a1523a81-8865-401e-8ae6-c9bd26faee02> a skos:Concept ;
    dcterms:created "2022-05-17T03:40:34"^^xsd:dateTime ;
    dcterms:modified "2025-10-14T22:15:38"^^xsd:dateTime ;
    dcterms:source <https://www.nrs.fs.fed.us/fia/topics/dwm/glossary/> ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/a8b1a7fb-b479-48ff-b706-b3cc4691710b> ;
    skos:definition "Dead branches, twigs, wood splinters 1 - 10cm in diameter."@en ;
    skos:example "Any observations made or derived from fine woody debris. For example, the count, length and/or mass of fine woody debris in a forest area." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "fine woody debris"@en .

<http://linked.data.gov.au/def/tern-cv/a1cd1820-458f-422c-b346-aec7612a39f9> a skos:Concept ;
    dcterms:created "2024-04-17T23:55:04"^^xsd:dateTime ;
    dcterms:modified "2025-10-03T04:07:12"^^xsd:dateTime ;
    dcterms:source "http://purl.obolibrary.org/obo/NCIT_C14340"^^xsd:anyURI ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/ea6c4b26-2fa1-4d0e-9413-b53f248f2269> ;
    skos:definition "A community of non-vascular plants. Plants that do not have vascular tubes/tissues to transport food and water. It belongs to the division Bryophyta, which includes liverwort, and moss." ;
    skos:example "A community of lichens, mosses and liverworts sampled from a tropical montane rainforest." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "non-vascular plants community"@en .

<http://linked.data.gov.au/def/tern-cv/a4c351f8-741e-4790-a62e-00af9dfcb28c> a skos:Concept ;
    dcterms:created "2024-04-16T04:25:16"^^xsd:dateTime ;
    dcterms:description "As of 2024, there are 566 Local Government Areas covering the whole of Australia, including unincorporated areas, without gaps or overlaps. This incorporates 19 non-spatial special purpose codes including a new Outside Australia code. ABS approximations of administrative boundaries do not match official legal boundaries and should only be used for statistical purposes."@en ;
    dcterms:modified "2025-10-13T23:13:41"^^xsd:dateTime ;
    dcterms:source "Australian Bureau of Statistics. (Jul2021-Jun2026). Australia and State/Territory. ABS. https://www.abs.gov.au/statistics/standards/australian-statistical-geography-standard-asgs-edition-3/jul2021-jun2026/main-structure-and-greater-capital-city-statistical-areas/australia-and-stateterritory." ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/05dac53a-269c-4699-9673-bf99a9406b14> ;
    skos:definition "Local Government Areas are an ABS Mesh Block approximation of gazetted local government boundaries as defined by each state and territory."@en ;
    skos:example "Local Government Areas (LGA) serve as a feature of interest for biodiversity, habitat, and ecosystem monitoring. Each government area represents a relatively large adminstrative unit of land or water containing a assemblage of species and natural communities managed within the local government administrative area." ;
    skos:historyNote "Added as a narrower of 'administrative area' in the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "Local Government Areas"@en .

<http://linked.data.gov.au/def/tern-cv/a5179275-33e7-4eed-b57c-474787ac39ea> a skos:Concept ;
    dcterms:created "2024-04-16T04:40:34"^^xsd:dateTime ;
    dcterms:description "There are 867 terrestrial ecoregions, classified into 14 different biomes such as forests, grasslands, or deserts."@en ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "Olson, D. M., Dinerstein, E., Wikramanayake, E. D., Burgess, N. D., Powell, G. V. N., Underwood, E. C., D'Amico, J. A., Itoua, I., Strand, H. E., Morrison, J. C., Loucks, C. J., Allnutt, T. F., Ricketts, T. H., Kura, Y., Lamoreux, J. F., Wettengel, W. W., Hedao, P., Kassem, K. R. 2001. Terrestrial ecoregions of the world: a new map of life on Earth. Bioscience 51(11):933-938." ;
    skos:altLabel "Terrestrial Ecoregions of the World (TEOW)" ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/05dac53a-269c-4699-9673-bf99a9406b14> ;
    skos:definition "The WWF Ecoregions, also referred to as Terrestrial Ecoregions of the World (TEOW) is a biogeographic regionalization of the earth's terrestrial biodiversity. The biogeographic units are ecoregions, which are defined as relatively large units of land or water containing a distinct assemblage of natural communities sharing a large majority of species, dynamics, and environmental conditions."@en ;
    skos:example "WWF Ecoregions serve as a feature of interest for biodiversity, habitat, and ecosystem monitoring. Each ecoregion represents a relatively large unit of land or water containing a geographically distinct assemblage of species and natural communities on which observations can be made at that ecoregion." ;
    skos:historyNote "Added as a narrower of 'administrative area' in the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "WWF Ecoregions"@en ;
    schema:citation "Olson, D. M., Dinerstein, E., Wikramanayake, E. D., Burgess, N. D., Powell, G. V. N., Underwood, E. C., D'Amico, J. A., Itoua, I., Strand, H. E., Morrison, J. C., Loucks, C. J., Allnutt, T. F., Ricketts, T. H., Kura, Y., Lamoreux, J. F., Wettengel, W. W., Hedao, P., Kassem, K. R. 2001. Terrestrial ecoregions of the world: a new map of life on Earth. Bioscience 51(11):933-938." .

<http://linked.data.gov.au/def/tern-cv/ae71c3f6-d430-400f-a1d4-97a333b4ee02> a skos:Concept ;
    dcterms:created "2021-02-01T04:29:24"^^xsd:dateTime ;
    dcterms:description "Collection of individuals belonging to the same species, living in the same area (Silvertown and Charlesworth 2001). In practice, the focal set of individuals and the spatial scale of the populations has to be define." ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "Silvertown, Jonathan, and Deborah Charlesworth. Introduction to plant population biology. John Wiley & Sons, 2009." ;
    skos:broadMatch <http://vocabs.lter-europe.net/EnvThes/20715> ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/881bcb98-1c31-4710-a9a4-58dbe1bc4a95> ;
    skos:definition "Group of individuals of the same plant species living within a given area." ;
    skos:example "In the TERN vocabs the plant population is a feature of interest representing a population of a given plant species. For example, 1. The population of Corymbia clarksoniana in a Eucalypt woodland; 2. 20 individuals of Taraxacum officinalis" ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "plant-population" ;
    skos:prefLabel "plant population"@en ;
    schema:citation "Silvertown, Jonathan, and Deborah Charlesworth. Introduction to plant population biology. John Wiley & Sons, 2009." .

<http://linked.data.gov.au/def/tern-cv/aef12cd6-3826-4988-a54c-8578d3fb4c8d> a skos:Concept ;
    dcterms:created "2021-05-10T02:34:49"^^xsd:dateTime ;
    dcterms:description "Land surface substrate is the combination of soil, rock, dead plant materials which make up the land surface." ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "McDonald, R.C., Isbell, R.F., Speight, J.G., Walker, J. and Hopkins, M.S., 1998. Australian soil and land survey: field handbook (No. Ed. 2). CSIRO publishing." ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/8282fb22-4135-415c-8ca2-317860d102fb> ;
    skos:definition "Materials, soils or rock that can be found on the land surface." ;
    skos:example "1. decomposing plant matter on a forest floor; 2. The abundance of coarse fragments." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "land-surface-substrate" ;
    skos:prefLabel "land surface substrate"@en ;
    schema:citation "McDonald, R.C., Isbell, R.F., Speight, J.G., Walker, J. and Hopkins, M.S., 1998. Australian soil and land survey: field handbook (No. Ed. 2). CSIRO publishing." .

<http://linked.data.gov.au/def/tern-cv/b123913b-d601-4777-9298-7576c44879d2> a skos:Concept ;
    dcterms:created "2022-08-23T01:35:59"^^xsd:dateTime ;
    dcterms:description "A single invertebrate individual (animals that neither possess nor develop a vertebral column)." ;
    dcterms:modified "2025-10-01T06:18:32"^^xsd:dateTime ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/86758d4d-e4d9-4d03-9e5d-f528bb4a5889> ;
    skos:definition "An invertebrate which is physiologically distinct and independent." ;
    skos:example "Venom extracted from a tagged funnel-web spider over time." ;
    skos:historyNote "Added to the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "invertebrate-individual" ;
    skos:prefLabel "invertebrate individual"@en .

<http://linked.data.gov.au/def/tern-cv/b293a07e-a1ff-4a4e-9af9-922057d5d742> a skos:Concept ;
    dcterms:created "2024-11-04T06:11:22"^^xsd:dateTime ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "Godfree, RC, Knerr, N, Encinas-Viso, F, Albrecht, D, Bush, D, Cargill, DC, Clements, M, Gueidan, C, Guja, LK, Harwood, T (2021) Implications of the 2019–2020 megafires for the biogeography and conservation of Australian vegetation. Nature communications 12, 1–13." ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/7e256d28-e686-4b6a-b64a-ac1b1a8f164d> ;
    skos:definition "Fire events that disrupt the ecosystem, community, or population structure and changes resources, substrate availability, or the physical environment." ;
    skos:example "Observations on plant char height made in a forest plot after a fire event." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "fire disturbance"@en ;
    schema:citation "Godfree, RC, Knerr, N, Encinas-Viso, F, Albrecht, D, Bush, D, Cargill, DC, Clements, M, Gueidan, C, Guja, LK, Harwood, T (2021) Implications of the 2019–2020 megafires for the biogeography and conservation of Australian vegetation. Nature communications 12, 1–13." .

<http://linked.data.gov.au/def/tern-cv/b311c0d3-4a1a-4932-a39c-f5cdc1afa611> a skos:Concept ;
    dcterms:created "2021-10-06T23:53:25"^^xsd:dateTime ;
    dcterms:description "Plant occurrence can be used to describe the distribution and abundance of plants within a population or community, and it is often used in studies of plant populations and communities. Plant occurrence can be influenced by many factors, such as environmental conditions, competition for resources, and interactions with other species. Plant occurrence is an important concept in plant ecology because it provides information about the distribution and abundance of plants in a given area, which can help to understand the dynamics of plant populations and communities." ;
    dcterms:modified "2024-04-17T06:18:57"^^xsd:dateTime ;
    skos:altLabel "plant sample" ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/881bcb98-1c31-4710-a9a4-58dbe1bc4a95> ;
    skos:closeMatch <http://rs.tdwg.org/dwc/terms/Occurrence> ;
    skos:definition "In the context of plant ecology, plant occurrence typically refers to the presence of a single plant or a group of plants of the same species in a specific area." ;
    skos:example "1) A clump of grass sampled at a point intercept along a transect; 2) An individual tree sampled along a transect. 3) An Ironbark population on State Forest. 4) A plant in Kakadu National Park in the dry season of 2020." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "plant-occurrence" ;
    skos:prefLabel "plant occurrence"@en .

<http://linked.data.gov.au/def/tern-cv/b9a72809-6d53-4dad-bac6-bfe4dc76be31> a skos:Concept ;
    dcterms:created "2023-01-17T03:43:55"^^xsd:dateTime ;
    dcterms:description "Soil subsites are sampled to capture soil diversity across the plot, with soil characters that are atypical of the soil pit recorded at each sub-site." ;
    dcterms:modified "2023-06-28T00:43:29"^^xsd:dateTime ;
    dcterms:source "Laws M, McCallum K, Cox B, Bignall J, Matthews K, O’Neill S, Sparrow B. (unpublished draft) ‘Soils module’ in ….. (eds) Ecological Field Monitoring Protocols Manual: Standardising environmental monitoring and data systems for improved decision making. Draft v 0.1 Report to DAWE. TERN, Adelaide." ;
    owl:deprecated true ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/98e8d72d-f361-41ed-af9d-6e7f90c1dfce> ;
    skos:definition "A soil subsite is a spatial point within a plot used for soil characterisation to capture the soil diversity across the plot." ;
    skos:example "The soil horizon depth in a subsite." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "soil sub-pits"@en .

<http://linked.data.gov.au/def/tern-cv/bab5d9ff-cd5f-4d15-868a-598c98044d21> a skos:Concept ;
    dcterms:created "2024-04-16T04:10:39"^^xsd:dateTime ;
    dcterms:description "CAPAD, published every 2 years (since 1997), is used to provide a national perspective of the conservation of biodiversity in protected areas. It also allows Australia to report on the status of protected areas to meet international obligations such as those under the Convention on Biological Diversity (CBD)"@en ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/05dac53a-269c-4699-9673-bf99a9406b14> ;
    skos:definition "Collaborative Australian Protected Areas Database (CAPAD) is a textual and spatial database with information available for terrestrial protected areas covering 169,941,262 ha (22.1 per cent) of the Australian landmass. "@en ;
    skos:exactMatch <https://www.dcceew.gov.au/environment/land/nrs/science/capad> ;
    skos:example "CAPAD serve as a feature of interest for Australian biodiversity, habitat, and ecosystem monitoring. Each protected area represents a relatively large unit of land and/or water containing a geographically distinct assemblage of species and natural communities. CAPAD 2024 shows Australia now has 14,575 terrestrial protected areas, covering 22.57 per cent of the Australian landmass, 319 marine protected areas and 11 Sea Country Indigenous Protected Areas that collectively cover 48.9 per cent of Australian waters." ;
    skos:historyNote "Added as a narrower of 'administrative area' in the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "CAPAD" ;
    skos:prefLabel "Collaborative Australian Protected Areas Database (CAPAD)"@en .

<http://linked.data.gov.au/def/tern-cv/bc02be3f-6c9c-4abe-bec9-5c2de8497897> a skos:Concept ;
    dcterms:created "2022-08-23T03:58:52"^^xsd:dateTime ;
    dcterms:description "An invertebrate occurrence (animals that neither possess nor develop a vertebral column) is a sample of an invertebrate individual or group of invertebrates at a particular point and time." ;
    dcterms:modified "2025-10-01T06:18:44"^^xsd:dateTime ;
    dcterms:source "http://rs.tdwg.org/dwc/terms/Occurrence"^^xsd:anyURI ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/86758d4d-e4d9-4d03-9e5d-f528bb4a5889> ;
    skos:definition "An existence of a single invertebrate or group of invertebrates sampled at a particular place at a particular time." ;
    skos:example "1. The presence of moths in a tree canopy at a given time.; 2. A group of invertebrates of a particular taxonomic rank sampled from the topsoil in a tropical rainforest" ;
    skos:historyNote "Updated the heirarchy of the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "invertebrate-occurrence" ;
    skos:prefLabel "invertebrate occurrence"@en .

<http://linked.data.gov.au/def/tern-cv/c4e95889-9205-432f-9748-e83966e742c9> a skos:Concept ;
    dcterms:created "2022-08-15T06:19:57"^^xsd:dateTime ;
    dcterms:description "An occurrence is a sample of an reptile individual or group of reptiles at a particular point and time." ;
    dcterms:modified "2025-10-01T06:22:01"^^xsd:dateTime ;
    dcterms:source "http://rs.tdwg.org/dwc/terms/Occurrence"^^xsd:anyURI ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/5cd1dbb0-c30e-4c8e-ae1b-0b388638163c> ;
    skos:definition "An existence of reptile sampled at a particular place at a particular time." ;
    skos:example "The presence of lizards in Granite Belt National Park, Queensland." ;
    skos:historyNote "Updated the heirarchy of the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "reptile-occurrence" ;
    skos:prefLabel "reptile occurrence"@en .

<http://linked.data.gov.au/def/tern-cv/c61dd945-c6e5-4287-8349-90ef2d5c304e> a skos:Concept ;
    dcterms:created "2024-04-16T05:24:15"^^xsd:dateTime ;
    dcterms:modified "2024-04-19T04:40:30"^^xsd:dateTime ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/86758d4d-e4d9-4d03-9e5d-f528bb4a5889> ;
    skos:definition "An invertebrate community (i.e., animals that neither possess nor develop a vertebral column) are a group or invertebrates of different species and or populations living in a geographic area." ;
    skos:example "A collection of beetles or ants from a region." ;
    skos:historyNote "Added to the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "invertebrate community"@en .

<http://linked.data.gov.au/def/tern-cv/c8385d99-2c71-4e52-ae94-4895745e0e36> a skos:Concept ;
    dcterms:created "2024-04-16T04:01:23"^^xsd:dateTime ;
    dcterms:description "The latest version, IBRA7, classifies Australia's landscapes into 89 large geographically distinct bioregions based on common climate, geology, landform, native vegetation and species information. For example, the Australian Alps, the Nullabor Plain and the Wet Tropics are distinct bioregions. The 89 bioregions are further refined to form 419 subregions which are more localised and homogenous geomorphological units in each bioregion. The bioregions and subregions are defined in the IBRA7 bioregional map. "@en ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    skos:altLabel "Australia's IBRA" ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/05dac53a-269c-4699-9673-bf99a9406b14> ;
    skos:definition "The Interim Biogeographic Regionalisation for Australia (IBRA) are bioregions based on a national and regional planning framework for the systematic development of a comprehensive, adequate and representative (‘CAR’) National Reserve System."@en ;
    skos:exactMatch <https://www.dcceew.gov.au/environment/land/nrs/science/ibra> ;
    skos:example "IBRA bioregions serve as a feature of interest for Australian biodiversity, habitat, and ecosystem monitoring. Each region represents a relatively large unit of land or water containing a geographically distinct assemblage of species and natural communities." ;
    skos:historyNote "Added as a narrower of 'administrative area' in the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "IBRA" ;
    skos:prefLabel "Interim Biogeographic Regionalisation for Australia (IBRA)"@en .

<http://linked.data.gov.au/def/tern-cv/c8a66c8a-af06-44fc-b556-3ff242e622aa> a skos:Concept ;
    dcterms:created "2022-07-14T03:54:36"^^xsd:dateTime ;
    dcterms:modified "2023-06-23T06:22:29"^^xsd:dateTime ;
    owl:deprecated true ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/2be2d5ce-ca9d-4dff-8e79-948983944f95> ;
    skos:definition "A set of plants exhibiting similar responses to environmental conditions and having similar effects on the dominant ecosystem processes." ;
    skos:description "Plant functional types represent broad groupings of plant species that share similar characteristics (e.g. growth form) and roles (e.g. photosynthetic pathway) in ecosystem function." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "plant-functional-type" ;
    skos:prefLabel "plant functional type"@en .

<http://linked.data.gov.au/def/tern-cv/caab05f4-084e-4cd8-b219-199529807d3d> a skos:Concept ;
    dcterms:created "2021-12-17T03:50:10"^^xsd:dateTime ;
    dcterms:description "A stem often bears leaves and buds. It is usually above ground, and is more or less negatively geotropic. A shoot axis (PO:0025029) that is the primary axis of a plant." ;
    dcterms:modified "2022-07-15T03:29:23"^^xsd:dateTime ;
    owl:deprecated true ;
    skos:definition "A shoot axis that is the primary axis of a plant." ;
    skos:exactMatch <http://purl.obolibrary.org/obo/PO_0009047> ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "individual-stem" ;
    skos:prefLabel "plant stem individual"@en .

<http://linked.data.gov.au/def/tern-cv/cb92dce1-d0ab-4ed7-b586-9a55bc31c3d6> a skos:Concept ;
    dcterms:created "2024-11-26T23:16:36"^^xsd:dateTime ;
    dcterms:modified "2026-09-06T23:39:29"^^xsd:dateTime ;
    owl:deprecated true ;
    skos:altLabel "Australian CZO Network Site",
        "CZO Site",
        "OzCZO Site" ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/5bf7ae21-a454-440b-bdd7-f2fe982d8de4> ;
    skos:definition "Monitoring site sampling a diversity of Australia’s geologies, biomes, land uses and climates. Critical Zone Observatory Sites host automated monitoring infrastructure to record stocks and flows of carbon, water, energy and mass across the Critical Zone—the vertical span from plant canopies to fresh bedrock." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "critical zone observatory site"@en .

<http://linked.data.gov.au/def/tern-cv/cd5cbdbb-07d9-4a5b-9b11-5ab9d6015be6> a skos:Concept ;
    dcterms:created "2021-11-24T02:21:51"^^xsd:dateTime ;
    dcterms:description "An animal specimen is used for vouchering purposes. Animal specimens can include whole or part/s of animal such as hair, nails, etc. that will be archived in a collection or museum for future studies." ;
    dcterms:modified "2025-10-01T06:17:51"^^xsd:dateTime ;
    dcterms:source "http://purl.org/zonmw/generic/10009"^^xsd:anyURI ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/f6a6cdf8-d8cf-4e2d-b2c1-febd8a41a07b> ;
    skos:definition "A part of an animal, or of whole animal, taken and stored in a preservative for potential future use to demonstrate or to determine the traits or behaviour of the animal." ;
    skos:example "Hair sample number 113AB collected from a possum during a vertebrate fauna survey." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "animal-specimen" ;
    skos:prefLabel "animal specimen"@en .

<http://linked.data.gov.au/def/tern-cv/cdb28aaa-bcec-431b-9afe-e8a03d9ef11c> a skos:Concept ;
    dcterms:created "2021-02-01T04:37:24"^^xsd:dateTime ;
    dcterms:modified "2025-10-30T00:26:53"^^xsd:dateTime ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/2e122e23-881c-43fa-a921-a8745f016ceb> ;
    skos:definition "A sample (or part) of the voucher specimen of a plant." ;
    skos:example "Voucher specimen samples can be an important feature of interest, when observations are made on those samples. For example, species identification for plants by designating a scientific name from observations on plant morphological features from a sample twig in a specimen." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "plant voucher specimen sample"@en .

<http://linked.data.gov.au/def/tern-cv/cff98a66-48bb-4654-ad6d-a5f36079efae> a skos:Concept ;
    dcterms:created "2023-06-23T01:36:43"^^xsd:dateTime ;
    dcterms:description "Theoretically, it is useful to consider the complete set of animals belonging to all species living in a particular place and time as an animal community (community sensu lato Vellend 2016). In practice, studies often focus on a subset of the whole animal community chosen on the basis of growth, taxonomy or particular interactions (Morin 2011)." ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "Morin, P. J. Community ecology. Wiley. (2011); Vellend, Mark. The theory of ecological communities (MPB-57). Princeton University Press, 2020." ;
    skos:broadMatch <http://vocabs.lter-europe.net/EnvThes/20715> ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/f6a6cdf8-d8cf-4e2d-b2c1-febd8a41a07b> ;
    skos:definition "Group of animals representing multiple species living in a specified place and time." ;
    skos:example "1. Birds from different species present-in, or sharing the same water body.; 2. Measurements of total mass made for all the mammals residing in a given ecological niche." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "animal-community" ;
    skos:prefLabel "animal community"@en ;
    schema:citation "Morin, P. J. Community ecology. Wiley. (2011); Vellend, Mark. The theory of ecological communities (MPB-57). Princeton University Press, 2020." .

<http://linked.data.gov.au/def/tern-cv/d63f3330-5687-4c55-bb91-184fa062a755> a skos:Concept ;
    dcterms:created "2022-08-19T04:13:12"^^xsd:dateTime ;
    dcterms:description "A reptile indvidual is a physiological independent individual that has some kind of autonomous agency and has a life cycle that allow them to form some kind of reproductive lineages." ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "Wilson, Robert A., and Matthew Barker. The biological notion of individual. (2007)." ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/1554c27a-e777-49da-abc3-10296734f80b> ;
    skos:definition "Physiologically distinct and independent reptile." ;
    skos:example "An individual snake identified and tagged with a microchip for studying their feeding behaviour over time." ;
    skos:historyNote "Updated the heirarchy of the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "reptile-individual" ;
    skos:prefLabel "reptile individual"@en ;
    schema:citation "Wilson, Robert A., and Matthew Barker. The biological notion of individual. (2007)." .

<http://linked.data.gov.au/def/tern-cv/d738a3f9-9b00-4adf-9dc8-0577269b691d> a skos:Concept ;
    dcterms:created "2021-02-23T04:51:29"^^xsd:dateTime ;
    dcterms:description "Soil specimens, are collected for their preservation. Information about the type of specimens, the amount of material, the specimen id, collection depth, latitude and longitude, date of collection and soil moisture content/conditions of collection are recorded." ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "Simons, B., Wilson, P., Ritchie, A. and Cox, S., 2013, April. ANZSoilML: an Australian-New Zealand standard for exchange of soil data. In EGU General Assembly Conference Abstracts (pp. EGU2013-6802)." ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/98e8d72d-f361-41ed-af9d-6e7f90c1dfce> ;
    skos:definition "A preserved (physical) soil sample." ;
    skos:example "A soil sample preserved in a collection usually with a voucher number." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "soil-specimen" ;
    skos:prefLabel "soil specimen"@en ;
    schema:citation "Simons, B., Wilson, P., Ritchie, A. and Cox, S., 2013, April. ANZSoilML: an Australian-New Zealand standard for exchange of soil data. In EGU General Assembly Conference Abstracts (pp. EGU2013-6802)." .

<http://linked.data.gov.au/def/tern-cv/de081296-00ba-4ddf-aa7a-947bf3a3e0aa> a skos:Concept ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "Rondeux, J., Sanchez, C. Review of indicators and field methods for monitoring biodiversity within national forest inventories. Core variable: Deadwood. Environ Monit Assess 164, 617–630 (2010). https://doi.org/10.1007/s10661-009-0917-6" ;
    owl:deprecated true ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/c001183f-c6b5-4162-8de9-0c7ed0eb3bfe> ;
    skos:definition "An individual piece of dead wood (diameter >10cm) including downed, dead tree and shrub boles, large limbs, and other woody pieces that are severed from their original source of growth."@en ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "coarse woody debris piece"@en ;
    schema:citation "Rondeux, J., Sanchez, C. Review of indicators and field methods for monitoring biodiversity within national forest inventories. Core variable: Deadwood. Environ Monit Assess 164, 617–630 (2010). https://doi.org/10.1007/s10661-009-0917-6" .

<http://linked.data.gov.au/def/tern-cv/de1e18e4-6cfd-4c78-b389-a5b1dd04b899> a skos:Concept ;
    dcterms:created "2023-01-10T04:09:56"^^xsd:dateTime ;
    dcterms:description "Horizon is a soil layer which is parallel to the soil surface and which has roughly homogenous physical, chemical and biological properties relative to the soil layers above or beneath it." ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    dcterms:source "McDonald, R.C., Isbell, R.F., Speight, J.G., Walker, J. and Hopkins, M.S., 1998. Australian soil and land survey: field handbook (No. Ed. 2). CSIRO publishing." ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/98e8d72d-f361-41ed-af9d-6e7f90c1dfce> ;
    skos:definition "A vertical section of a soil profile." ;
    skos:example "1) The O horizon is composed of humus; 2) The colour of the B horizon." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "soil horizon"@en ;
    schema:citation "McDonald, R.C., Isbell, R.F., Speight, J.G., Walker, J. and Hopkins, M.S., 1998. Australian soil and land survey: field handbook (No. Ed. 2). CSIRO publishing." .

<http://linked.data.gov.au/def/tern-cv/de46fa49-d1c9-4bef-8462-d7ee5174e1e1> a skos:Concept ;
    dcterms:created "2021-05-11T02:59:21"^^xsd:dateTime ;
    dcterms:modified "2026-10-19T05:29:51+00:00"^^xsd:dateTime ;
    skos:altLabel "line transect" ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/5bf7ae21-a454-440b-bdd7-f2fe982d8de4> ;
    skos:definition "A survey method in which observers record the presence, abundance, or behavior of organisms along a straight line of known length, either by walking, driving, or viewing from a fixed position. It is commonly used in ecology to estimate species distribution and population density." ;
    skos:exactMatch <http://linked.data.gov.au/def/corveg-cv/de357d5f-0a69-4c25-9da5-d581371438fa> ;
    skos:historyNote "In the earlier version, the concept was defined as 'A line along which biotic and abiotic characteristics are sampled', and belongs to 'Site type' scheme. Updated on 08/09/2025 with new definition, added it to the 'Method type' scheme and added an altLabel and exactMatch." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "transect"@en .

<http://linked.data.gov.au/def/tern-cv/e0eff420-ec86-4cad-b321-97dd5bfd83b0> a skos:Concept ;
    dcterms:created "2024-04-18T03:34:25"^^xsd:dateTime ;
    dcterms:description "Non-woody plants are those that do not produce secondary growth in the form of wood. They include herbaceous species such as grasses, forbs, ferns, etc." ;
    dcterms:modified "2024-04-18T04:41:20"^^xsd:dateTime ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/2217ab3c-0359-42a3-9361-b3b895121841> ;
    skos:definition "The presence of non-woody plants at a specific location and time." ;
    skos:example "An individual or a group of sedges sampled from a rocky outcrop during the dry season." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:prefLabel "non-woody vascular plant occurrence"@en .

<http://linked.data.gov.au/def/tern-cv/e1021d25-7d76-4faa-bfcc-fb6d225eb3ec> a skos:Concept ;
    dcterms:modified "2026-02-24T22:41:38"^^xsd:dateTime ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/8cadf069-01d7-4420-b454-cae37740c2a2> ;
    skos:definition "A plot within a survey region that is established for long-term monitoring, where abiotic and biotic properties are repeatedly sampled over time to track changes.",
        "Whether the plot has been placed permanently or not." ;
    skos:historyNote "Updated on 08/09/2025 to include this concept to 'Site type' scheme, as a narrow concept of 'plot'. Also update the definition accordingly." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d>,
        <http://linked.data.gov.au/def/tern-cv/dd085299-ae86-4371-ae15-61dfa432f924> ;
    skos:prefLabel "permanent plot" ;
    skos:topConceptOf <http://linked.data.gov.au/def/tern-cv/dd085299-ae86-4371-ae15-61dfa432f924> .

<http://linked.data.gov.au/def/tern-cv/e16f8309-5db3-4efb-ba4d-a352fb3dcd94> a skos:Concept ;
    dcterms:created "2022-08-12T00:07:56"^^xsd:dateTime ;
    dcterms:description "A mammal occurrence is a sample of a mammal (class Mammalia) at a particular point and time. A mammal occurrence may come from an individual or a group." ;
    dcterms:modified "2025-10-01T06:21:51"^^xsd:dateTime ;
    dcterms:source "http://rs.tdwg.org/dwc/terms/Occurrence"^^xsd:anyURI ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/5cd1dbb0-c30e-4c8e-ae1b-0b388638163c> ;
    skos:definition "An existence of mammal sampled at a particular place at a particular time." ;
    skos:example "The presence of a Wombat or a group of Wombats recorded from a camera trap survey in Cradle mountain, Tasmania." ;
    skos:historyNote "Updated the heirarchy of the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "mammal-occurrence" ;
    skos:prefLabel "mammal occurrence"@en .

<http://linked.data.gov.au/def/tern-cv/e196c39e-959f-4dd4-8816-d0a58b7cc630> a skos:Concept ;
    dcterms:created "2023-06-23T04:10:11"^^xsd:dateTime ;
    dcterms:description "Weather events are short-term conditions of the lower atmosphere such as precipitation, temperature, humidity, wind direction, wind speed, and atmospheric pressure." ;
    dcterms:modified "2024-06-28T01:30:24"^^xsd:dateTime ;
    dcterms:source "https://education.nationalgeographic.org/resource/weather-or-climate-whats-difference/" ;
    skos:altLabel "weather events" ;
    skos:broader <http://linked.data.gov.au/def/tern-cv/db6d3a22-8bf4-4e27-a9a4-a49e228b6f52> ;
    skos:definition "State of the atmosphere, including temperature, atmospheric pressure, wind, humidity, precipitation, and cloudiness." ;
    skos:example "1. A rainfall event characterized by severe thunderstorms.; 2. A heatwave event where the maximum and minimum ambient air temperature is unusually hot over 3 days." ;
    skos:historyNote "Added the label 'weather events' as altLabel and as a narrower of 'atmosphere' in the TERN Feature Type (Release version, 2024)." ;
    skos:inScheme <http://linked.data.gov.au/def/tern-cv/68af3d25-c801-4089-afff-cf701e2bd61d> ;
    skos:notation "weather-events" ;
    skos:prefLabel "weather"@en .

