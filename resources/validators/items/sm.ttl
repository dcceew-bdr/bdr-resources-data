PREFIX : <https://linked.data.gov.au/def/bdr-spr/sm/validator/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX sg: <https://linked.data.gov.au/def/bdr-pr/sm/validator>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX sm: <https://linked.data.gov.au/def/bdr-pr/sm/>
PREFIX smrr: <https://linked.data.gov.au/dataset/bdr/smrr/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

sg:
    a sh:ShapesGraph ;
    owl:versionIRI :2.1 ;
    owl:versionInfo """2.1 Aligned with Submission Manifest Ontology

2.0 Version first used in the Data Ingestion Portal DEV for MONITOR data

1.0 First version""" ;
    schema:creator <https://linked.data.gov.au/org/dcceew> ;
    schema:dateCreated "2025-02-15"^^xsd:date ;
    schema:dateModified "2026-11-11"^^xsd:date ;
    schema:description "SHACL validator for the BDR Submission Manifest Model"@en ;
    schema:name "BDR Submission Manifest Model Validator"@en ;
    schema:publisher <https://linked.data.gov.au/org/dcceew> ;
    schema:version "2.1" ;
    skos:historyNote "2026-11-11: Added names, descriptions and defining-validator links to the five named NodeShapes and corrected the validator description predicate. Validation constraints and version identifiers are unchanged."@en ;
.

:shape-01
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    schema:name "Manifest resource descriptors"@en ;
    schema:description "Each Submission Manifest must have at least one prof:hasResource value."@en ;
    sh:property
        [
            sh:message "A Submission Manifest must have at least one Resource Descriptor indicated by hasResource" ;
            sh:minCount 1 ;
            sh:path prof:hasResource ;
        ] ;
    sh:targetClass sm:SubmissionManifest ;
.

:shape-02
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    schema:name "Resource descriptor artifact references"@en ;
    schema:description "Each resource descriptor indicated by prof:hasResource must have at least one prof:hasArtifact value, and all supplied values must be xsd:string literals."@en ;
    sh:property
        [
            sh:datatype xsd:string ;
            sh:message "Each Resource Descriptor must have at least one literal artifact indicated with prof:hasArtifact" ;
            sh:minCount 1 ;
            sh:path prof:hasArtifact ;
        ] ;
    sh:targetObjectsOf prof:hasResource ;
.

:shape-03
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    schema:name "Resource descriptor role"@en ;
    schema:description "Each resource descriptor indicated by prof:hasResource must have exactly one prof:hasRole value, which must be an IRI."@en ;
    sh:property
        [
            sh:maxCount 1 ;
            sh:message "Each Resource Descriptor must have exactly one role IRI indicated with prof:hasRole" ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path prof:hasRole ;
        ] ;
    sh:targetObjectsOf prof:hasResource ;
.

:shape-04
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    schema:name "Resource role vocabulary membership"@en ;
    schema:description "Each role indicated by prof:hasRole must have exactly one skos:inScheme value: https://linked.data.gov.au/dataset/bdr/smrr/."@en ;
    sh:property
        [
            sh:hasValue smrr: ;
            sh:maxCount 1 ;
            sh:message "Each role indicated for a Resource Descriptor a member of the Submission Manifest Model Resource Roles Vocabulary, indicated with the skos:inScheme predicate for the role Concept" ;
            sh:minCount 1 ;
            sh:path skos:inScheme ;
        ] ;
    sh:targetObjectsOf prof:hasRole ;
.

:shape-05
    a sh:NodeShape ;
    rdfs:isDefinedBy sg: ;
    schema:name "Declared conformance shapes graph"@en ;
    schema:description "Each subject using sh:conformsToShapesGraph may have at most one value for that predicate, and each supplied value must be an IRI."@en ;
    sh:property
        [
            sh:maxCount 1 ;
            sh:message "sh:conformsToShapesGraph is optional and must have at most one value, which must be an IRI" ;
            sh:nodeKind sh:IRI ;
            sh:path sh:conformsToShapesGraph ;
        ] ;
    sh:targetSubjectsOf sh:conformsToShapesGraph ;
.

:2.1
    schema:name "2.1" ;
.
