PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

<urn:bdr:validation:PublishedRank> a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path skos:definition ; sh:minCount 1 ; sh:nodeKind sh:Literal ] ;
    sh:property [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://linked.data.gov.au/dataset/bdr/taxonomic-rank> ] ;
    sh:property [ sh:path skos:topConceptOf ; sh:hasValue <https://linked.data.gov.au/dataset/bdr/taxonomic-rank> ] .

<urn:bdr:validation:RankScheme> a sh:NodeShape ;
    sh:targetNode <https://linked.data.gov.au/dataset/bdr/taxonomic-rank> ;
    sh:class skos:ConceptScheme ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path skos:hasTopConcept ; sh:minCount 33 ; sh:maxCount 33 ; sh:class skos:Concept ] .
