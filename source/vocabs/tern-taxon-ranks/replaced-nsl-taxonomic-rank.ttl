cs:
    a skos:ConceptScheme ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Taxonomic_rank"^^xsd:anyURI ;
    skos:definition """A taxonomic rank denotes the level that a group of organisms — either taxon or clade — occupies in a hierarchical system of classification, which is usually but not necessarily based on evolutionary relationships between those organisms.

This vocabulary contains ranks present in the Australian National Species List (NSL)."""@en ;
    skos:hasTopConcept
        <http://linked.data.gov.au/def/tern-cv/2b6fae57-f28e-4f24-b6f9-19f114dbb61e> ,
        <http://linked.data.gov.au/def/tern-cv/3ade9854-d90f-4709-bb5a-260d62a2c647> ,
