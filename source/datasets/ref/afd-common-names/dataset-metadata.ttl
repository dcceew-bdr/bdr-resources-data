PREFIX d: <https://linked.data.gov.au/dataset/afd-common-names>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

d:
    a schema:Dataset ;
    schema:citation "CSV Extract of the AFD given to the BDR Team by the AFD Team and matched with scripts to NSL entries in the BDR. See source repo" ;
    schema:codeRepository "https://github.com/dcceew-bdr/bdr-resources-data/tree/main/source/datasets/ref/afd-common-names"^^xsd:anyURI ;
    schema:creator <https://linked.data.gov.au/org/dcceew> ;
    schema:creditText "Derived from the Australian Faunal Directory (AFD), National Species List." ;
    schema:dateCreated "2026-11-17"^^xsd:date ;
    schema:dateModified "2026-11-17"^^xsd:date ;
    schema:description """Common-names for animals from the AFD derived from an AFD extract given to the BDR Team by the AFD Team on 2026-11-17. .

Dataset structure follows that of the APNI Common Names dataset.""" ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:name "AFD Common Names" ;
    schema:publisher <https://linked.data.gov.au/org/dcceew> ;
    schema:version "1" ;
.
