PREFIX d: <https://linked.data.gov.au/dataset/apni-common-names>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

d:
    a schema:Dataset ;
    schema:citation "https://biodiversity.org.au/nsl/services/export/index"^^xsd:anyURI ;
    schema:codeRepository "https://github.com/dcceew-bdr/bdr-resources-data/tree/main/source/datasets/ref/apni-common-names"^^xsd:anyURI ;
    schema:creator <https://linked.data.gov.au/org/dcceew> ;
    schema:creditText "Derived from the Australian Plant Name Index (APNI), National Species List. The preserved source CSV supplies citations and attribution IRIs, all of which identify the scientific-name resources used as lookup subjects. Adapted into a deduplicated common-name lookup dataset." ;
    schema:dateCreated "2026-11-07"^^xsd:date ;
    schema:dateModified "2026-11-09"^^xsd:date ;
    schema:description """Common-name lookups from the APNI common-name export downloaded on 30 October 2026. The 64,714 source records yield 37,160 distinct scientific-name IRI and common-name text pairs across 17,204 scientific-name IRIs.

Each scientific-name IRI has its scientific-name text and associated common-name texts expressed with dwc:scientificName and dwc:vernacularName. These APNI IRIs identify names; no taxon class assertions are added. Repeated lookup pairs are deduplicated while many-to-many associations are retained. Name-usage and citation evidence is available from the NSL; the original CSV is preserved with the reproducible method.""" ;
    schema:identifier "APNI" ;
    schema:isBasedOn <https://biodiversity.org.au/nsl/services/export/index> ;
    schema:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    schema:name "APNI Common Names" ;
    schema:publisher <https://linked.data.gov.au/org/dcceew> ;
    schema:version "3" ;
.
